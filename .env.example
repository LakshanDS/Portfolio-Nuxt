# Copy to .env for local development (never commit the real .env).
# Production secrets are NOT read from this file — set them with
# `wrangler secret put SESSION_SECRET` or via the CI deploy step.

# HMAC secret for signing admin session cookies. Required — auth fails
# closed without it. Generate one: openssl rand -hex 32
SESSION_SECRET=

# Public site URL (defaults to http://localhost:3000 in dev).
# NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Database dialect for drizzle-kit generation (default: sqlite for Cloudflare D1).
# Only sqlite is wired; other dialects need a schema file + drizzle.config.ts entry first.
# DB_DIALECT=sqlite

# Debug logging in the run console.
# Set to 1/true to see debug output locally: LOG_DEBUG=1 bun dev
# LOG_DEBUG=
